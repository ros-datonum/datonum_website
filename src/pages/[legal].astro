---
// Legal template → /privacy, /terms, /service-terms and /dpa.
// Privacy Notice: GDPR (Reg. EU 2016/679) + LOPDGDD (LO 3/2018) + LSSI-CE (Ley 34/2002).
// Terms of Use: combined aviso legal (Art. 10 LSSI) + website conditions of use.
// IDENTITY placeholders (nif, address) are required by law — fill before publishing.
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';
import DataTable from '../components/DataTable.astro';
import { routes } from '../data/navigation.ts';

export function getStaticPaths() {
  return [
    { params: { legal: 'privacy' }, props: { variant: 'privacy', title: 'Privacy Notice' } },
    { params: { legal: 'terms' }, props: { variant: 'terms', title: 'Terms of Use' } },
    { params: { legal: 'service-terms' }, props: { variant: 'service-terms', title: 'Terms of Service' } },
    { params: { legal: 'dpa' }, props: { variant: 'dpa', title: 'Data Processing Agreement' } },
  ];
}

const { variant, title } = Astro.props;

const PRIVACY_LAST_UPDATED = '19 November 2026';
const TERMS_LAST_UPDATED = '19 November 2026';
const SERVICE_TERMS_LAST_UPDATED = '19 November 2026';
const DPA_LAST_UPDATED = '19 November 2026';
const legalEmail = 'legal@datonum.com';

// Service Terms, section 7: what monthly plans cover.
const planColumns = [
  { key: 'area', label: 'Area' },
  { key: 'covered', label: 'Covered' },
  { key: 'notCovered', label: 'Not covered' },
];
const planRows = [
  { area: 'Hosting', covered: 'Running your workflow on our EU server, within the monthly volume of your package', notCovered: 'Volume above the package limit (priced separately)' },
  { area: 'Monitoring', covered: 'Alerts on failed runs, checked on business days (Monday to Friday, 9:00–18:00 Madrid time)', notCovered: '24/7 monitoring or a guaranteed uptime percentage' },
  { area: 'Fixes', covered: 'Fixing failures caused by our setup, usually within 2 business days', notCovered: 'Failures caused by changes in your systems or by outages at third-party providers, beyond restarting once they recover' },
  { area: 'Tuning', covered: 'A monthly accuracy check and up to 2 small changes to categories, rules or documents', notCovered: 'New inboxes, new document types or new integrations (a new setup)' },
  { area: 'Contact', covered: 'Email, answered within 1 business day', notCovered: 'Phone support' },
];

// DPA, Annex 1: details of processing per package.
const annex1Columns = [
  { key: 'item', label: '' },
  { key: 'inbox', label: 'Inbox Desk' },
  { key: 'docs', label: 'Doc Intake' },
  { key: 'answers', label: 'Team Answers (with Run & Care)' },
];
const annex1Rows = [
  { item: 'Subject matter and purpose', inbox: 'Sorting emails in one shared inbox, routing them to the Customer’s tools and preparing reply drafts for the Customer’s staff to review', docs: 'Extracting agreed fields from the Customer’s documents into a table, with a human review step', answers: 'Answering staff questions from the Customer’s internal documents' },
  { item: 'Nature of processing', inbox: 'Reading, classifying, storing logs, generating drafts. No email is sent automatically', docs: 'Reading, extracting, storing, presenting for review', answers: 'Indexing documents, answering questions, periodic accuracy checks' },
  { item: 'Data subjects', inbox: 'Senders and recipients of emails to the inbox: customers, prospects, suppliers, the Customer’s staff', docs: 'People named in the documents: suppliers’ contacts, customers, staff, applicants (as agreed)', answers: 'The Customer’s staff; people named in internal documents' },
  { item: 'Personal data', inbox: 'Names, email addresses, phone numbers, message content, attachment metadata', docs: 'Names, contact details and other fields agreed in the scope', answers: 'Names, roles, contact details and other content of the documents' },
  { item: 'Special category data', inbox: 'Not intended. The Customer will exclude such messages where possible', docs: 'Not intended unless agreed in writing', answers: 'Not intended' },
  { item: 'Retention inside the service', inbox: 'Run logs: 14 days. Drafts stay in the Customer’s mailbox', docs: 'Source files: 30 days after extraction. Extracted data stays in the Customer’s table', answers: 'For the term of the service' },
  { item: 'Location', inbox: 'EU (Germany), plus sub-processors in Annex 3', docs: 'EU (Germany), plus sub-processors in Annex 3', answers: 'The Customer’s own AI workspace account; Datonum accesses it for maintenance' },
];

// DPA, Annex 2: technical and organisational measures.
const annex2Columns = [
  { key: 'area', label: 'Area' },
  { key: 'measure', label: 'Measure' },
];
const annex2Rows = [
  { area: 'Access', measure: 'Only the named Datonum owner has access to production systems. Server login by SSH key only, no passwords. Two-factor authentication on hosting, email and AI provider accounts' },
  { area: 'Least privilege', measure: 'Access to the Customer’s systems uses the narrowest permissions the service needs, through an app registered in the Customer’s own Google Workspace or Microsoft 365 account, which the Customer can revoke at any time' },
  { area: 'Encryption in transit', measure: 'All connections use HTTPS/TLS' },
  { area: 'Credentials', measure: 'Stored encrypted in the workflow tool, never in plain text files or email' },
  { area: 'Separation', measure: 'Each Customer has separate workflows and credentials' },
  { area: 'Data minimisation', measure: 'Only the inbox, folders or document types in the agreed scope are processed. Workflow run logs, which can contain message or document content, are deleted automatically after 14 days' },
  { area: 'Backups', measure: 'Daily, stored in Cloudflare R2 in a bucket restricted to the EU jurisdiction, kept for up to 35 days' },
  { area: 'Updates', measure: 'Operating system and workflow software patched at least monthly, critical fixes within 7 days' },
  { area: 'Monitoring', measure: 'Alerts on failed runs and unusual errors, reviewed on business days' },
  { area: 'AI providers', measure: 'Accessed only through paid business APIs or business plans, each under the provider’s data processing addendum. Free tiers and consumer accounts are never used for Customer Personal Data' },
  { area: 'Incidents', measure: 'Breach handling as in section 5; incidents logged with date, impact and actions taken' },
  { area: 'People', measure: 'Anyone given access is bound by confidentiality and gets access only for as long as needed' },
];

// DPA, Annex 3: approved sub-processors.
const annex3Columns = [
  { key: 'name', label: 'Sub-processor' },
  { key: 'purpose', label: 'Purpose' },
  { key: 'location', label: 'Location' },
  { key: 'transfer', label: 'Transfer mechanism' },
];
const annex3Rows = [
  { name: 'Hetzner Online GmbH', purpose: 'Server hosting for workflows', location: 'Germany (EU)', transfer: 'None needed (EU)' },
  { name: 'Cloudflare (R2 object storage)', purpose: 'Encrypted storage of backups', location: 'EU (bucket restricted to the EU jurisdiction)', transfer: 'None needed for storage in the EU; any access from outside the EU is covered by the SCCs in Cloudflare’s Data Processing Addendum' },
  { name: 'Anthropic (Claude API)', purpose: 'AI model that classifies, extracts and drafts', location: 'United States', transfer: 'EU Standard Contractual Clauses (Module 3) and UK Addendum, in Anthropic’s Data Processing Addendum' },
  { name: 'OpenAI (API and business plans, including Codex)', purpose: 'AI model that classifies, extracts and drafts; development tooling', location: 'Ireland (OpenAI Ireland Ltd for EEA data), with processing in the United States', transfer: 'Standard Contractual Clauses or an adequacy decision, under OpenAI’s Data Processing Addendum' },
  { name: 'Google (Gemini API, paid tier only)', purpose: 'AI model that classifies, extracts and drafts', location: 'United States and other countries where Google operates', transfer: 'As set out in Google’s Data Processing Addendum for products where Google is a data processor, referenced in the Gemini API Additional Terms' },
];
const lastUpdated =
  variant === 'privacy' ? PRIVACY_LAST_UPDATED
  : variant === 'service-terms' ? SERVICE_TERMS_LAST_UPDATED
  : variant === 'dpa' ? DPA_LAST_UPDATED
  : TERMS_LAST_UPDATED;
const contactEmail = 'hello@datonum.com';
// Legally required identification of the data controller / service provider.
const legalName = 'Rostyslav Bachyk';
const commercialName = 'Datonum';
const nif = 'Z0041311P';
const address = 'Avenida Fabraquer 3, 17J, El Campello, 03560 Alicante, Spain';

// Section 10 of the Privacy Notice. Names and durations as observed in the browser after
// accepting all cookies; re-check them when a provider changes its tags.
const cookieColumns = [
  { key: 'name', label: 'Name' },
  { key: 'provider', label: 'Provider' },
  { key: 'purpose', label: 'Purpose' },
  { key: 'category', label: 'Category' },
  { key: 'duration', label: 'Duration' },
];
const cookieRows = [
  { name: 'cc_cookie', provider: 'Datonum', purpose: 'Remembers your cookie choice', category: 'Necessary', duration: '12 months' },
  { name: 'dtn_first_touch, dtn_last_touch (local storage)', provider: 'Datonum', purpose: 'Which link or website brought you to us', category: 'Analytics', duration: '90 days' },
  { name: '__hstc', provider: 'HubSpot', purpose: 'Tracks visits', category: 'Analytics', duration: '6 months' },
  { name: 'hubspotutk', provider: 'HubSpot', purpose: 'Links your visits to an inquiry you submit', category: 'Analytics', duration: '6 months' },
  { name: '__hssc', provider: 'HubSpot', purpose: 'Counts pages in a session', category: 'Analytics', duration: '30 minutes' },
  { name: '__hssrc', provider: 'HubSpot', purpose: 'Detects a new session', category: 'Analytics', duration: 'Session' },
  { name: 'bcookie', provider: 'LinkedIn', purpose: 'Visitor demographics, conversion measurement, future ad targeting', category: 'Marketing', duration: '1 year' },
  { name: 'li_gc', provider: 'LinkedIn', purpose: 'Visitor demographics, conversion measurement, future ad targeting', category: 'Marketing', duration: '6 months' },
  { name: 'lidc', provider: 'LinkedIn', purpose: 'Visitor demographics, conversion measurement, future ad targeting', category: 'Marketing', duration: '1 day' },
  // Observed 20 Oct 2026 after accepting marketing, from a browser not signed in to LinkedIn.
  { name: 'li_sugr', provider: 'LinkedIn', purpose: 'Probabilistic matching of the visitor for conversion measurement', category: 'Marketing', duration: '3 months' },
  { name: 'bscookie', provider: 'LinkedIn', purpose: 'Secure browser identifier used by LinkedIn', category: 'Marketing', duration: '1 year' },
  { name: 'UserMatchHistory', provider: 'LinkedIn', purpose: 'Syncs the LinkedIn Ads ID for conversion measurement and ad targeting', category: 'Marketing', duration: '30 days' },
  { name: 'AnalyticsSyncHistory', provider: 'LinkedIn', purpose: 'Records when the visitor was last synced with LinkedIn', category: 'Marketing', duration: '30 days' },
  // Not observed from Spain: LinkedIn documents it only for traffic from outside the EU, EEA,
  // UK and Quebec (LinkedIn Help, "LinkedIn Insight Tag"), and does not publish a duration.
  { name: 'li_adsid (LinkedIn Ads ID)', provider: 'LinkedIn', purpose: 'First-party identifier for conversion measurement; only for visitors outside the EU, EEA, UK and Quebec', category: 'Marketing', duration: 'Not stated by LinkedIn' },
  { name: '__cf_bm', provider: 'HubSpot / LinkedIn (via Cloudflare bot management on their domains)', purpose: 'Bot detection on the provider’s servers', category: 'Set only after you accept analytics or marketing', duration: '30 minutes' },
];

const description =
  variant === 'privacy'
    ? 'How Datonum collects, uses and protects personal data, and your rights under the GDPR and Spanish data protection law.'
    : variant === 'service-terms'
      ? 'The terms for buying a Datonum package: scope, fit check, payment, acceptance tests, guarantee, ownership and liability.'
      : variant === 'dpa'
        ? 'Datonum’s Data Processing Agreement under GDPR Article 28: processing details, security measures and sub-processors.'
        : 'The terms for using datonum.com: acceptable use, intellectual property, disclaimers, limitation of liability and Spanish governing law.';
---

<PageLayout title={`${title} — Datonum`} description={description}>
  <section class="legal-hero">
    <div class="container">
      <span class="ihero__eyebrow">Legal</span>
      <h1 class="legal-title">{title}</h1>
    </div>
  </section>

  <section class="band band--card" style="padding:64px 0 96px">
    <div class="legal-body">
      <p class="legal-meta">Last updated: {lastUpdated}</p>

      {variant === 'privacy' && (
        <div class="legal-prose">
          <p class="legal-lead">
            This Privacy Notice explains how {commercialName} collects, uses and protects the personal
            data of people who visit datonum.com or get in touch with us. We process personal data in
            accordance with Regulation (EU) 2016/679 (GDPR), Spanish Organic Law 3/2018 on Data
            Protection and Digital Rights (LOPDGDD), and Law 34/2002 on Information Society Services
            and Electronic Commerce (LSSI-CE).
          </p>

          <h2>1. Who is responsible for your data</h2>
          <p>The data controller is:</p>
          <ul>
            <li>{legalName}, operating under the commercial name “{commercialName}”</li>
            <li>Tax identification number (NIE): {nif}</li>
            <li>Address: {address}</li>
            <li>Email: <a href={`mailto:${contactEmail}`} data-umami-event="email_click">{contactEmail}</a></li>
          </ul>
          <p>
            We have not appointed a Data Protection Officer, as our processing does not meet the
            thresholds in Article 37 GDPR. You can raise any privacy matter with us at the email above.
          </p>

          <h2>2. Scope</h2>
          <p>
            This Notice covers personal data collected through this website, our inquiry form and email
            correspondence with us, and our contact with business professionals we reach out to on
            LinkedIn, and the details of customers who buy a package. It does not cover third-party websites we link to, which have their
            own privacy policies.
          </p>

          <h2>3. What personal data we collect</h2>
          <p><strong>Information you give us.</strong> When you complete the inquiry form or email us,
            we collect your first name, last name, email address, company name and the content of your
            message, together with anything else you choose to include. All fields are required;
            without them we can’t reply to your inquiry.</p>
          <p><strong>Information about business contacts we reach out to.</strong> If we contact you on
            LinkedIn about our services, we obtained your name, job title, company and LinkedIn profile
            URL from your LinkedIn profile or LinkedIn Sales Navigator, together with publicly available
            information about your company. We use it to contact you about a specific business process
            and to keep a record of our conversation in our CRM (HubSpot). If you tell us you are not
            interested, we stop contacting you and keep only a minimal record (your name and company)
            so that we do not contact you again.</p>
          <p><strong>Information collected automatically.</strong> When you visit the site, your
            request passes through Cloudflare, which delivers and protects the site on our behalf (as
            our processor) and in doing so processes technical data such as your IP address, browser
            and device type, and the pages you request. Our own web server keeps no access log of
            your visits; it keeps only a small technical error log, which does not contain your IP
            address.</p>
          <p><strong>Performance measurement.</strong> Cloudflare also provides us with Cloudflare Web
            Analytics: a small script on each page reports how quickly the page loaded, together with
            the page address, referring website, and browser and device type. It does not use cookies
            or local storage, and does not create an identifier to recognise you or track you across
            other websites. Cloudflare processes this data on our behalf (as our processor).</p>
          <p><strong>Usage analytics.</strong> We use Umami, a privacy-focused, cookieless analytics
            tool that we host on our own infrastructure, to understand how the site is used. It records
            aggregated information such as the pages viewed, the referring website, and your approximate
            location, browser and device type. It does not use cookies, does not store your IP address,
            and does not create a persistent identifier or track you across other websites.</p>
          <p><strong>Cookies and similar technologies, with your consent.</strong> If you accept them in
            our cookie banner, we also use:</p>
          <ul>
            <li><strong>Attribution data</strong> — we store in your browser (local storage) the campaign
              parameters of the link that brought you to our site (for example “LinkedIn post”), the
              first page you visited and the referring website, so that if you later contact us we know
              which channel reached you. Kept for up to 90 days.</li>
            <li><strong>Session recording</strong> — our self-hosted Umami tool records how you
              interact with our pages (mouse movement, clicks, scrolling, navigation) so we can review
              playbacks and improve the site. It uses no cookies, does not store your IP address, and
              masks everything you type into form fields.</li>
            <li><strong>HubSpot tracking</strong> — With your consent, we use HubSpot tracking
              technologies to record the pages you visit on our website. If you subsequently submit an
              inquiry, this browsing history may be associated with your contact record in our CRM. We
              use this information to understand interest in our services and provide relevant context
              when responding to inquiries and managing business relationships.</li>
            <li><strong>LinkedIn Insight Tag</strong> — LinkedIn cookies let LinkedIn report to us, in
              aggregated form, the professional characteristics of our visitors (such as industry, job
              function and company size) and, in future, let us show our content on LinkedIn to people
              who have visited our site.</li>
          </ul>
          <p>
            None of these run unless you opt in, and you can withdraw your choice at any time through
            “Cookie settings” at the bottom of every page.
          </p>
          <p>
            We do not intentionally collect special categories of data (such as health, political or
            religious information). Please do not include sensitive personal data in your message.
          </p>

          <h2>4. Why we use it, and our legal basis</h2>
          <ul>
            <li><strong>To process your order when you buy a package</strong> — billing, invoicing, the
              onboarding form, and records of your acceptance of our Terms of Service and Data
              Processing Agreement — Article 6(1)(b) GDPR (performance of a contract) and 6(1)(c) (tax
              and accounting obligations).</li>
            <li><strong>To respond to your inquiry</strong> and take steps at your request before any
              possible engagement — Article 6(1)(b) GDPR, and, where you contact us on behalf of an
              organisation, our legitimate interest in responding, Article 6(1)(f).</li>
            <li><strong>To manage and follow up on business inquiries</strong> and keep records in our
              CRM — Article 6(1)(f), our legitimate interest in developing and managing business
              relationships.</li>
            <li><strong>To contact business professionals on LinkedIn about our services</strong> and
              keep a record of those conversations — Article 6(1)(f), our legitimate interest in
              business-to-business marketing. You can object at any time by replying to our message or
              emailing <a href={`mailto:${contactEmail}`} data-umami-event="email_click">{contactEmail}</a>.</li>
            <li><strong>To operate and secure the website</strong> (content delivery and protection by
              Cloudflare, technical error logs) —
              Article 6(1)(f), our legitimate interest in the security and proper functioning of the
              site.</li>
            <li><strong>To measure and improve how the site is used and how fast it loads</strong>
              through privacy-friendly, cookieless analytics (Umami and Cloudflare Web Analytics) —
              Article 6(1)(f), our legitimate interest in understanding and
              improving our website.</li>
            <li><strong>To understand which channels bring visitors and inquiries</strong>, to link an
              inquiry to the pages viewed before it, to record sessions, and to measure and target our
              LinkedIn activity, using the cookies and similar technologies described above — Article 6(1)(a) GDPR, your
              consent (and Article 22.2 LSSI-CE), which you can withdraw at any time.</li>
            <li><strong>To meet legal, accounting and tax obligations</strong> — Article 6(1)(c).</li>
            <li><strong>To send marketing communications</strong>, only where you have expressly asked
              us to — Article 6(1)(a) consent, which you may withdraw at any time.</li>
          </ul>
          <p>
            Where we rely on legitimate interests, we have assessed that they are not overridden by your
            rights and freedoms. You may object to this processing at any time (see “Your rights”).
          </p>

          <h2>5. Who we share it with</h2>
          <p>We do not sell your personal data. We share it only with:</p>
          <ul>
            <li><strong>HubSpot</strong> — our customer relationship management platform; inquiry-form
              submissions, and, if you accept analytics cookies, your browsing on our site, are stored
              there on servers in the European Union (acting as our processor).</li>
            <li><strong>LinkedIn</strong> — If you consent to marketing technologies, we use the
              LinkedIn Insight Tag to measure website visits, understand audience characteristics and
              support advertising activities. LinkedIn processes data collected through the Insight Tag
              as an independent controller under its <a
                href="https://www.linkedin.com/legal/l/linkedin-independent-controller-addendum"
                target="_blank" rel="noopener">Independent Controller Addendum</a>. LinkedIn’s <a
                href="https://www.linkedin.com/legal/privacy-policy" target="_blank" rel="noopener">Privacy
                Policy</a> and <a href="https://www.linkedin.com/legal/cookie-policy" target="_blank"
                rel="noopener">Cookie Policy</a> explain its processing practices and the rights available
              to individuals.</li>
            <li><strong>Hetzner Online GmbH</strong> (Germany) — hosting of this website and of our
              self-hosted analytics (processor).</li>
            <li><strong>Cloudflare</strong> — content delivery and security in front of our website,
              and cookieless performance measurement (Cloudflare Web Analytics) (processor).</li>
            <li><strong>Stripe</strong> — processes payments when you buy a package. Stripe collects your
              payment details directly; we receive your name, company, email, billing address and VAT
              number, but never your full card details. Stripe processes this data under its own <a
              href="https://stripe.com/privacy" target="_blank" rel="noopener">Privacy Policy</a> and
              may process it in the United States; that policy describes the safeguards it uses.</li>
            <li><strong>Professional advisers</strong> (such as accountants or legal advisers), where
              necessary and under a duty of confidentiality.</li>
            <li><strong>Public authorities</strong>, where we are legally required to disclose.</li>
          </ul>
          <p>
            Where a provider processes personal data on our behalf, it does so under a data processing
            agreement as required by Article 28 GDPR.
          </p>

          <h2>6. International data transfers</h2>
          <ul>
            <li>HubSpot stores the data we hold in it in its EU data centre. HubSpot, Inc. (US) may
              access it remotely for support and security; these transfers are covered by the EU–US
              Data Privacy Framework, including the UK Extension, and by the European Commission’s
              Standard Contractual Clauses with the UK Addendum, under HubSpot’s data processing
              agreement.</li>
            <li>Cloudflare, Inc. (US) is certified under the EU–US Data Privacy Framework, including
              the UK Extension; its data processing agreement also includes Standard Contractual
              Clauses.</li>
            <li>LinkedIn processes Insight Tag data as an independent controller, and that data may be
              transferred to and stored by LinkedIn Corporation in the United States. LinkedIn
              Corporation is certified under the EU–US Data Privacy Framework, including the UK
              Extension.</li>
            <li>Hetzner hosts our website and analytics in Germany; this data is not transferred
              outside the EEA.</li>
          </ul>
          <p>You may request a copy of the relevant safeguards using the contact details above.</p>

          <h2>7. How long we keep it</h2>
          <ul>
            <li><strong>Inquiries that do not lead to a business relationship:</strong> up to 12 months
              from our last contact, after which they are deleted or anonymised.</li>
            <li><strong>Data relating to a client relationship:</strong> for the duration of the
              relationship and thereafter for the periods required by law — for example, tax and
              accounting records are kept for up to 6 years under Spanish commercial and tax law.</li>
            <li><strong>Business contacts we reached out to:</strong> up to 12 months after our last
              contact, unless a business relationship starts; a minimal do-not-contact record is kept for
              as long as needed to respect your objection.</li>
            <li><strong>Server logs:</strong> we keep no access logs of visits. Technical error logs,
              which contain no visitor IP addresses, are limited to 2 MB and overwritten
              automatically.</li>
            <li><strong>Usage analytics:</strong> kept for up to 24 months.</li>
            <li><strong>Performance measurement (Cloudflare Web Analytics):</strong> held by Cloudflare
              in our account for its standard Web Analytics retention period; we do not export it.</li>
            <li><strong>Session recordings:</strong> kept for up to 30 days.</li>
            <li><strong>Attribution data in your browser:</strong> up to 90 days.</li>
            <li><strong>Your cookie choice:</strong> 12 months.</li>
            <li><strong>HubSpot and LinkedIn cookies:</strong> see the table in section 10.</li>
          </ul>
          <p>We keep personal data no longer than necessary for the purposes described above.</p>

          <h2>8. Your rights</h2>
          <p>
            You have the right to request access to your personal data, and its rectification or
            erasure; to restrict or object to its processing; to data portability; and not to be
            subject to decisions based solely on automated processing that produce legal or similarly
            significant effects (we do not carry out such decision-making). Where processing is based on
            your consent, you may withdraw it at any time, without affecting processing carried out
            beforehand.
          </p>
          <p>
            To exercise your rights, email <a href={`mailto:${contactEmail}`} data-umami-event="email_click">{contactEmail}</a>. We may
            need to confirm your identity. We will respond within one month (extendable by two further
            months for complex requests), and doing so is free of charge.
          </p>
          <p>
            If you consider that we have not handled your data correctly, you may lodge a complaint with
            the Spanish Data Protection Agency (Agencia Española de Protección de Datos, AEPD), C/ Jorge
            Juan 6, 28001 Madrid — <a href="https://www.aepd.es" target="_blank" rel="noopener">www.aepd.es</a>.
            We would appreciate the chance to resolve your concern first.
          </p>

          <h2>9. Security</h2>
          <p>
            We apply appropriate technical and organisational measures — including encryption in
            transit, access controls and the use of reputable providers — to protect personal data
            against unauthorised access, loss or alteration. No transmission over the internet can be
            guaranteed to be completely secure.
          </p>

          <h2 id="cookies">10. Cookies and similar technologies</h2>
          <p>
            Our usage analytics (Umami) and performance measurement (Cloudflare Web Analytics) are
            cookieless and run without any storage on your device;
            session recording runs only if you accept analytics. Everything else listed below is used only after you agree to it in our
            cookie banner. You can change your choice at any time through “Cookie settings” at the
            bottom of every page, or delete cookies in your browser settings.
          </p>
          <DataTable columns={cookieColumns} rows={cookieRows} dense />
          <p>
            LinkedIn may set additional cookies, particularly for visitors signed in to LinkedIn; see <a
              href="https://www.linkedin.com/legal/cookie-policy" target="_blank" rel="noopener">LinkedIn’s
              Cookie Policy</a>.
          </p>

          <h2>11. Children</h2>
          <p>
            This website and our services are directed at businesses and professionals, not at children.
            We do not knowingly collect personal data from anyone under 14, the age of digital consent
            in Spain.
          </p>

          <h2>12. Changes to this Notice</h2>
          <p>
            We may update this Notice from time to time. The version in force, with its date, is always
            shown on this page, and we will highlight material changes where appropriate.
          </p>
        </div>
      )}

      {variant === 'terms' && (
        <div class="legal-prose">
          <p class="legal-lead">
            These Terms govern your access to and use of datonum.com. By using the site, you accept
            these Terms. If you do not agree with them, please do not use the site.
          </p>

          <h2>1. Who runs this website</h2>
          <p>In accordance with Article 10 of Law 34/2002 (LSSI-CE), the provider of this website is:</p>
          <ul>
            <li>{legalName}, commercial name “{commercialName}”</li>
