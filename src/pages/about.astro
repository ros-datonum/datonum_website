---
// About. Rebuilt from the prototype "About" screen. Copy verbatim.
import PageLayout from '../layouts/PageLayout.astro';
import ChecklistItem from '../components/ChecklistItem.astro';
import Avatar from '../components/Avatar.astro';
import CTABanner from '../components/CTABanner.astro';

const story = [
  'The useful writing about AI in business is aimed at organizations with engineering teams, data functions, and someone whose job is to evaluate this. That describes almost none of the businesses actually doing the work — the recruitment agency, the accountancy practice, the contractor, the freight forwarder.',
  'Those businesses have the same recurring load and none of the internal capability to address it. They get approached by vendors selling excitement and by consultancies selling strategy decks. Very few people show up, look at how the work actually moves, and say plainly what is worth doing.',
  'That is the gap Datonum works in.',
];
const setup = [
  'Based in Madrid, working across Europe.',
  'Small by design. Engagements are run by the person who scoped them.',
  'We take on a limited number of implementations at a time so stabilization periods are real rather than nominal.',
];
const peopleIcon = '<path d="M15.5 20v-1.5a3.5 3.5 0 0 0-3.5-3.5H6a3.5 3.5 0 0 0-3.5 3.5V20"></path><circle cx="9" cy="8" r="3.5"></circle><path d="M21.5 20v-1.5a3.5 3.5 0 0 0-2.6-3.4"></path><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8"></path>';
---

<PageLayout
  title="About — Datonum"
  description="Datonum exists because most AI advice is written for companies that do not need it. We work with founder-led service businesses that have the recurring load and none of the internal capability to address it."
>
  <section class="ihero wm-hero">
    <div class="container">
      <span class="ihero__eyebrow">About</span>
      <h1 class="ihero__title" style="max-width:26ch">Datonum exists because most AI advice is written for companies that do not need it</h1>
    </div>
  </section>

  <section class="band band--card wm-story">
    <div class="container split split--7-5">
      <div class="split__body" style="gap:20px">
        <span class="eyebrow eyebrow--teal">The story</span>
        {story.map((p, i) => <p class={i === 0 ? 'lead-muted' : 'muted'} style="max-width:66ch">{p}</p>)}
      </div>
      <div class="split__body" style="gap:24px">
        <div class="info-card" style="gap:16px">
          <span class="eyebrow eyebrow--teal">Who runs it</span>
          <div style="display:flex;align-items:center;gap:14px">
            <Avatar name="Rostyslav Bachyk" size={44} />
            <div style="display:flex;flex-direction:column;gap:2px">
              <span class="ruled-item__title">Rostyslav Bachyk</span>
              <span class="side-card__label">Founder</span>
            </div>
          </div>
          <p class="muted">Datonum is led by Rostyslav Bachyk, working with a small group of specialists brought in by engagement. Background in delivery operations — how service businesses plan work, track it, and lose margin on it.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--grey band--bordered wm-setup" style="padding:80px 0">
    <div class="container split split--4-8">
      <div class="split__side">
        <span class="eyebrow eyebrow--teal">Set-up</span>
        <h2 class="h2" style="max-width:16ch">
          <span class="h2mark"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={peopleIcon} /></span>How we are set up
        </h2>
      </div>
      <ul class="checklist">
        {setup.map((s) => <ChecklistItem tone="included">{s}</ChecklistItem>)}
      </ul>
    </div>
  </section>

  <section class="band band--card band--cta">
    <div class="container">
      <CTABanner
        title="Tell us what your team keeps redoing."
        lead="Thirty minutes, no preparation needed. We will tell you honestly whether AI would help or whether simpler automation would do the job."
      />
    </div>
  </section>
</PageLayout>

<style>
  .ihero.wm-hero { padding: 104px 0 88px; }
  .wm-hero {
    background-image: var(--wm-da);
    background-position: right min(calc(50% + 596px + var(--wm-k) * 188px / 2), calc(100% + var(--wm-k) * 188px - 24px)) top 38%;
    background-size: calc(var(--wm-k) * 188px);
  }
  .wm-story {
    background-image: var(--wm-b); background-repeat: no-repeat;
    background-position: left min(calc(50% + 592px + var(--wm-k) * 176px / 2), calc(100% + var(--wm-k) * 176px - 24px)) top 24%;
    background-size: calc(var(--wm-k) * 176px);
  }
  .wm-setup {
    background-image: var(--wm-d); background-repeat: no-repeat;
    background-position: left min(calc(50% + 594px + var(--wm-k) * 112px / 2), calc(100% + var(--wm-k) * 112px - 24px)) bottom -18px;
    background-size: calc(var(--wm-k) * 112px);
  }
</style>
