---
// Insights article. One template for every Markdown file in src/content/insights/.
// No design export covers this screen: it is composed from the case study detail
// (ink hero, 7/5 split with a side card) and the legal pages' prose rhythm, tokens only.
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { routes, serviceLinks } from '../../data/navigation.ts';
import { caseStudies, caseStudyPath } from '../../data/caseStudies.ts';
import { founder } from '../../data/site.ts';
import { getInsights, insightPath, formatArticleDate } from '../../data/insights.ts';
import { articleSchema, breadcrumbSchema } from '../../data/structuredData.ts';

const RELATED_INSIGHTS_LIMIT = 3;

export async function getStaticPaths() {
  const insights = await getInsights();
  return insights.map((insight) => ({
    params: { slug: insight.id },
    props: { insight, others: insights.filter((other) => other.id !== insight.id) },
  }));
}

const { insight, others } = Astro.props;
const { title, metaTitle, description, publishedDate, updatedDate, relatedService, relatedCaseStudy } = insight.data;
const { Content } = await render(insight);

const path = insightPath(insight.id);
const service = serviceLinks.find((link) => link.href === routes[relatedService]);
const caseStudy = caseStudies.find((study) => study.slug === relatedCaseStudy);
const moreInsights = others.slice(0, RELATED_INSIGHTS_LIMIT);

const structuredData = [
  articleSchema(
    Astro.site,
    { name: title, description, path },
    { authorName: founder.name, published: publishedDate, updated: updatedDate },
  ),
  breadcrumbSchema(Astro.site, [
    { label: 'Insights', href: routes.insights },
    { label: title, href: path },
  ]),
];
---

<PageLayout title={`${metaTitle ?? title} — Datonum`} description={description} ogType="article" structuredData={structuredData}>
  <section class="ihero article-hero">
    <div class="container">
      <a href={routes.insights} class="article-back">← Insights</a>
      <time class="article-kicker" datetime={publishedDate.toISOString()}>{formatArticleDate(publishedDate)}</time>
      <h1 class="ihero__title article-title">{title}</h1>
      <p class="ihero__lead">{description}</p>
    </div>
  </section>

  <section class="band band--card">
    <div class="container split split--7-5 article-split">
      <article class="article-prose">
        <Content />
      </article>

      <aside class="side-card article-side">
        <div class="side-card__row">
          <span class="side-card__label">Written by</span>
          <span class="side-card__value">{founder.name}, {founder.jobTitle}</span>
        </div>
        <div class="side-card__row">
          <span class="side-card__label">Published</span>
          <span class="side-card__value">{formatArticleDate(publishedDate)}</span>
        </div>
        {updatedDate && (
          <div class="side-card__row">
            <span class="side-card__label">Updated</span>
            <span class="side-card__value">{formatArticleDate(updatedDate)}</span>
          </div>
        )}
        {service && (
          <div class="side-card__row">
            <span class="side-card__label">Related service</span>
            <a href={service.href} class="article-side__link">{service.label}</a>
          </div>
        )}
        {caseStudy && (
          <div class="side-card__row">
            <span class="side-card__label">Related case study</span>
            <a href={caseStudyPath(caseStudy.slug)} class="article-side__link">{caseStudy.indexTitle}</a>
          </div>
        )}
      </aside>
    </div>
  </section>

  {moreInsights.length > 0 && (
    <section class="band band--grey band--bordered">
      <div class="container">
        <h2 class="eyebrow eyebrow--teal">More insights</h2>
        <div class="article-more">
          {moreInsights.map((other) => (
            <a href={insightPath(other.id)} class="article-more__row">
              <span class="case-card__title">{other.data.title}</span>
              <span class="muted">{other.data.description}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class:list={['band--card', 'band--tail', moreInsights.length > 0 && 'article-cta']}>
    <div class="container">
      <CTABanner
        location="article"
        title="Tell us what your team keeps redoing."
        lead="Thirty minutes, no preparation needed. We will tell you honestly whether AI would help or whether simpler automation would do the job."
      />
    </div>
  </section>
</PageLayout>

<style>
  .article-hero { padding: var(--space-20) 0 var(--space-20); }
  .article-back { font: var(--type-small); color: var(--navy-300); border-bottom: none; }
  .article-kicker { display: block; font: var(--type-data); color: var(--teal-500); margin-top: var(--space-6); }
  .article-title { margin-top: var(--space-4); max-width: 24ch; }

  .article-split { gap: var(--space-16); }

  /* The article body is rendered Markdown, so its elements are styled from the wrapper. */
  .article-prose { display: flex; flex-direction: column; max-width: 68ch; }
  .article-prose :global(h2) { font: var(--type-h3); letter-spacing: var(--tracking-heading); color: var(--text-strong); margin: var(--space-10) 0 var(--space-3); text-wrap: pretty; }
  .article-prose :global(h3) { font: var(--type-h4); color: var(--text-strong); margin: var(--space-6) 0 var(--space-2); text-wrap: pretty; }
  .article-prose :global(> :first-child) { margin-top: 0; }
  .article-prose :global(p) { font: var(--type-body); color: var(--grey-600); margin: 0 0 var(--space-4); text-wrap: pretty; }
  .article-prose :global(ul),
  .article-prose :global(ol) { margin: 0 0 var(--space-4); padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .article-prose :global(li) { font: var(--type-body); color: var(--grey-600); text-wrap: pretty; }
  .article-prose :global(strong) { color: var(--text-strong); font-weight: 600; }
  .article-prose :global(a) { color: var(--text-link); border-bottom: 1px solid var(--border-accent); }
  .article-prose :global(a:hover) { color: var(--text-link-hover); }
  .article-prose :global(blockquote) { margin: var(--space-2) 0 var(--space-6); padding-left: var(--space-5); border-left: 2px solid var(--border-accent); }
  .article-prose :global(blockquote p) { font: var(--type-quote); color: var(--text-strong); margin: 0; }
  .article-prose :global(code) { font: var(--type-data); background: var(--surface-sunken); border-radius: var(--radius-xs); padding: 0 var(--space-1); }
  .article-prose :global(hr) { border: 0; border-top: 1px solid var(--border-subtle); margin: var(--space-8) 0; }
  .article-prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 var(--space-6); }
  .article-prose :global(th) { font: var(--type-label); color: var(--text-strong); text-align: left; padding: var(--space-3); border-bottom: 2px solid var(--navy-800); }
  .article-prose :global(td) { font: var(--type-body); color: var(--grey-600); padding: var(--space-3); border-bottom: 1px solid var(--border-subtle); vertical-align: top; }

  .article-side { position: sticky; top: calc(var(--space-24) + var(--space-2)); }
  .article-side :global(.side-card__row:last-child) { padding-bottom: 0; border-bottom: none; }
  .article-side__link { font: var(--type-body); align-self: flex-start; }

  .article-more { display: flex; flex-direction: column; margin-top: var(--space-6); border-top: 1px solid var(--border-subtle); }
  .article-more__row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-8); padding: var(--space-6) var(--space-3); border-bottom: 1px solid var(--border-subtle); color: inherit; transition: background-color var(--duration-fast) var(--ease-standard); }
  .article-more__row:hover { background-color: var(--surface-card); }

  /* Only needed when the grey "More insights" band sits directly above the banner. */
  .article-cta { padding-top: var(--space-16); }

  @media (max-width: 1024px) {
    .article-side { position: static; top: auto; }
    .article-more__row { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
