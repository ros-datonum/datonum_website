---
// Button. Ported from DS Button.jsx; JS hover/press states reworked as CSS so the
// static site ships no runtime. Renders <a> when href is set, otherwise <button>.
interface Props {
  variant?: 'primary' | 'accent' | 'secondary' | 'ghost' | 'inverse' | 'inverse-outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  class?: string;
}
const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  class: className,
} = Astro.props;

const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  fullWidth && 'btn--full',
  disabled && 'is-disabled',
  className,
];
const Tag = href && !disabled ? 'a' : 'button';
---

<Tag
  class:list={classes}
  href={href && !disabled ? href : undefined}
  type={Tag === 'button' ? type : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  {...disabled && Tag === 'button' ? { disabled: true } : {}}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font: var(--weight-semibold) var(--text-sm) / 1 var(--font-sans);
    letter-spacing: 0.01em;
    border-radius: var(--radius-control);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition-control);
    white-space: nowrap;
  }

  /* sizes */
  .btn--sm { padding: 7px 14px; font-size: var(--text-xs); }
  .btn--md { padding: 10px 18px; }
  .btn--lg { padding: 14px 26px; font-size: var(--text-body); }

  /* variants */
  .btn--primary { background: var(--action-primary); color: var(--action-primary-text); border-color: var(--action-primary); }
  .btn--accent { background: var(--action-accent); color: var(--white); border-color: var(--action-accent); }
  .btn--secondary { background: var(--surface-card); color: var(--text-strong); border-color: var(--action-secondary-border); }
  .btn--ghost { background: transparent; color: var(--text-strong); border-color: transparent; }
  .btn--inverse { background: var(--white); color: var(--navy-800); border-color: var(--white); }
  .btn--inverse-outline { background: transparent; color: var(--white); border-color: rgba(255, 255, 255, 0.4); }

  /* hover */
  .btn--primary:not(.is-disabled):hover { background: var(--action-primary-hover); border-color: var(--action-primary-hover); }
  .btn--accent:not(.is-disabled):hover { background: var(--action-accent-hover); border-color: var(--action-accent-hover); }
  .btn--secondary:not(.is-disabled):hover { background: var(--action-secondary-hover); border-color: var(--border-strong); }
  .btn--ghost:not(.is-disabled):hover { background: var(--surface-sunken); }
  .btn--inverse:not(.is-disabled):hover { background: var(--navy-050); border-color: var(--navy-050); }
  .btn--inverse-outline:not(.is-disabled):hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.7); }

  .btn:not(.is-disabled):active { transform: translateY(1px); }

  .btn--full { width: 100%; }
  .is-disabled { opacity: 0.45; cursor: not-allowed; }
</style>
