---
// Minimal local icon. The DS Icon pulled Lucide from a CDN; a static site can't depend
// on that, so the handful of Lucide 0.454.0 glyphs the design uses are inlined here.
// Add a glyph only when a page actually needs it — this is not a general icon set.
interface Props {
  name: 'check' | 'minus' | 'x' | 'arrow-right' | 'chevron-down' | 'lightbulb' | 'triangle-alert';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  minus: '<path d="M5 12h14"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  lightbulb: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5C17.7 10.2 18 9 18 8a6 6 0 0 0-12 0c0 1 .2 2.2 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  'triangle-alert': '<path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style="display:block;flex:0 0 auto"
  set:html={paths[name]}
/>
