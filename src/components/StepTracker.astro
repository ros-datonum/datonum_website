---
// Step tracker. Ported from DS StepTracker.jsx. Steps are strings or { label, detail }.
import Icon from './Icon.astro';

interface Step {
  label: string;
  detail?: string;
}
interface Props {
  steps: (string | Step)[];
  current?: number;
  orientation?: 'vertical' | 'horizontal';
}
const { steps, current = 0, orientation = 'vertical' } = Astro.props;
const items = steps.map((s) => (typeof s === 'string' ? { label: s } : s));
---

<ol class:list={['steps', `steps--${orientation}`]}>
  {items.map((s, i) => {
    const state = i < current ? 'done' : i === current ? 'active' : 'todo';
    return (
      <li class="steps__item">
        <span class:list={['steps__mark', `is-${state}`]}>
          {state === 'done' ? <Icon name="check" size={14} /> : i + 1}
        </span>
        <span class="steps__text">
          <span class:list={['steps__label', state === 'todo' && 'is-todo']}>{s.label}</span>
          {s.detail && <span class="steps__detail">{s.detail}</span>}
        </span>
      </li>
    );
  })}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: flex; }
  .steps--vertical { flex-direction: column; gap: var(--space-5); }
  .steps--horizontal { flex-direction: row; gap: var(--space-8); }
  .steps__item { display: flex; gap: var(--space-3); align-items: flex-start; position: relative; }
  .steps--horizontal .steps__item { flex: 1; }
  .steps__mark {
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: var(--weight-semibold) var(--text-xs) / 1 var(--font-mono);
    background: var(--surface-card);
    color: var(--text-muted);
    border: 1px solid var(--border-strong);
  }
  .steps__mark.is-done { background: var(--teal-600); color: var(--white); border-color: var(--teal-600); }
  .steps__mark.is-active { background: var(--navy-800); color: var(--white); border-color: var(--navy-800); }
  .steps__text { display: flex; flex-direction: column; gap: 2px; padding-top: 3px; }
  .steps__label { font: var(--weight-semibold) var(--text-sm) / 1.3 var(--font-sans); color: var(--text-strong); }
  .steps__label.is-todo { color: var(--text-body); }
  .steps__detail { font-family: var(--font-sans); font-size: var(--text-xs); line-height: var(--leading-normal); color: var(--text-muted); }
</style>
