---
// Site-wide document shell. Loads the Datonum design-system tokens once
// (src/styles/styles.css chains every tokens/*.css) and exposes head metadata.
import '../styles/webfonts.css';
import '../styles/styles.css';
import '../styles/watermarks.css';
import '../styles/site.css';
import { toRoutePath } from '../data/navigation.ts';
import { siteIdentity, shareImage } from '../data/site.ts';
import type { StructuredDataNode } from '../data/structuredData.ts';

interface Props {
  title: string;
  description?: string;
  /** Open Graph object type: 'article' for case studies, 'website' everywhere else. */
  ogType?: 'website' | 'article';
  /** schema.org JSON-LD nodes for this page (see data/structuredData.ts). */
  structuredData?: StructuredDataNode[];
}

const { title, description, ogType = 'website', structuredData = [] } = Astro.props;
const canonical = new URL(toRoutePath(Astro.url.pathname), Astro.site).href;
const shareImageUrl = new URL(shareImage.path, Astro.site).href;

// Privacy-first analytics (self-hosted Umami). Only rendered when configured,
// so local dev and previews don't emit tracking.
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiRecorderSrc = import.meta.env.PUBLIC_UMAMI_RECORDER_SRC;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiDomains = import.meta.env.PUBLIC_UMAMI_DOMAINS;

// Consent-gated trackers. Rendered as type="text/plain" so the browser ignores them; the
// cookie banner (scripts/consent.ts) executes each only once its data-category is accepted.
// Each tag renders only when its ID is configured.
const hubspotPortalId = import.meta.env.PUBLIC_HUBSPOT_PORTAL_ID;
const hubspotRegion = import.meta.env.PUBLIC_HUBSPOT_REGION || 'na1';
// na1 loads from js.hs-scripts.com; other regions use js-<region>.hs-scripts.com
const hubspotScriptHost = hubspotRegion === 'na1' ? 'js.hs-scripts.com' : `js-${hubspotRegion}.hs-scripts.com`;
const linkedInPartnerId = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID;
---

<!doctype html>
<html lang={siteIdentity.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-var-latin.woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteIdentity.name} />
    <meta property="og:locale" content={siteIdentity.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={shareImageUrl} />
    {structuredData.map((node) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
    {umamiSrc && umamiWebsiteId && (
      <script
        is:inline
        defer
        src={umamiSrc}
        data-website-id={umamiWebsiteId}
        data-domains={umamiDomains}
        data-do-not-track="true"
        data-exclude-hash="true"
        data-performance="true"
      ></script>
    )}
    {umamiRecorderSrc && umamiWebsiteId && (
      <script is:inline defer src={umamiRecorderSrc} data-website-id={umamiWebsiteId}></script>
    )}
    {hubspotPortalId && (
      <script
        is:inline
        type="text/plain"
        data-category="analytics"
        id="hs-script-loader"
        async
        defer
        src={`https://${hubspotScriptHost}/${hubspotPortalId}.js`}
      ></script>
    )}
    {linkedInPartnerId && (
      <script is:inline type="text/plain" data-category="marketing" data-partner-id={linkedInPartnerId}>
        // LinkedIn Insight Tag, without LinkedIn's <noscript> pixel: visitors without
        // JavaScript never see the banner, so the pixel would track them without consent.
        // The partner ID arrives as an attribute, which the consent library carries over
        // when it executes this tag.
        window._linkedin_partner_id = document.currentScript.dataset.partnerId;
        window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
        window._linkedin_data_partner_ids.push(window._linkedin_partner_id);
        (function (l) {
          if (!l) {
            window.lintrk = function (a, b) { window.lintrk.q.push([a, b]); };
            window.lintrk.q = [];
          }
          var s = document.getElementsByTagName('script')[0];
          var b = document.createElement('script');
          b.type = 'text/javascript';
          b.async = true;
          b.src = 'https://snap.licdn.com/li.lms-analytics/insight.min.js';
          s.parentNode.insertBefore(b, s);
        })(window.lintrk);
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import { startConsentBanner } from '../scripts/consent.ts';
      startConsentBanner();
    </script>
  </body>
</html>
