# Copy to .env. Every value is public: PUBLIC_* vars are inlined into the client bundle at
# build time (the Dockerfile copies .env into the build stage).

# HubSpot: Forms API submit (contact form) and the consent-gated tracking code.
PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_HUBSPOT_FORM_GUID=
PUBLIC_HUBSPOT_REGION=eu1

# Umami (self-hosted, cookieless). Leave empty to disable tracking, e.g. in local dev.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_RECORDER_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_DOMAINS=datonum.com

# LinkedIn Insight Tag partner ID (consent-gated, marketing). Required in production;
# when empty the tag is not rendered.
PUBLIC_LINKEDIN_PARTNER_ID=11110585
